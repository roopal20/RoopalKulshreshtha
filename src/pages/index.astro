---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/Hero.astro";
import Credibility from "../components/Credibility.astro";
import Capabilities from "../components/Capabilities.astro";
import About from "../components/About.astro";
import Experience from "../components/Experience.astro";
import Projects from "../components/Projects.astro";
import Agentic from "../components/Agentic.astro";
import Conversational from "../components/Conversational.astro";
import Automation from "../components/Automation.astro";
import Skills from "../components/Skills.astro";
import Contact from "../components/Contact.astro";
import BlogCard from "../components/BlogCard.astro";
import { site } from "../content/site";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const recent = posts.slice(0, 3);
const base = import.meta.env.BASE_URL;
---

<Layout>
  <Header />
  <main>
    <Hero />
    <Credibility />
    <Capabilities />
    <Projects />
    <Agentic />
    <Conversational />
    <Automation />
    <Skills />
    <About />
    <Experience />

    <section class="section-max section-pad scroll-mt-24 py-16 sm:py-20">
      <div class="flex items-end justify-between gap-4">
        <div class="max-w-2xl">
          <h2 class="font-display text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
            {site.blog.title}
          </h2>
          <p class="mt-3 text-ink-muted">{site.blog.intro}</p>
        </div>
        <a
          href={`${base}blog`}
          class="shrink-0 text-sm font-semibold text-teal transition hover:text-teal-deep"
        >
          All posts →
        </a>
      </div>

      {
        recent.length === 0 ? (
          <p class="mt-8 text-ink-muted">{site.blog.emptyMessage}</p>
        ) : (
          <div class="mt-10 space-y-8">
            {recent.map((post) => (
              <BlogCard
                title={post.data.title}
                description={post.data.description}
                pubDate={post.data.pubDate}
                tags={post.data.tags}
                href={`${base}blog/${post.id}/`}
              />
            ))}
          </div>
        )
      }
    </section>

    <Contact />
  </main>
  <Footer />
</Layout>
