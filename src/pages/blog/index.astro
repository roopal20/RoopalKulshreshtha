---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import BlogCard from "../../components/BlogCard.astro";
import { site } from "../../content/site";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const base = import.meta.env.BASE_URL;
---

<Layout title="Blog" description={site.blog.intro}>
  <Header />
  <main class="section-max section-pad py-14 sm:py-20">
    <h1 class="font-display text-4xl font-semibold tracking-tight text-ink sm:text-5xl">
      {site.blog.title}
    </h1>
    <p class="mt-4 max-w-2xl text-lg text-ink-muted">{site.blog.intro}</p>

    {
      posts.length === 0 ? (
        <p class="mt-12 text-ink-muted">{site.blog.emptyMessage}</p>
      ) : (
        <div class="mt-12 space-y-10">
          {posts.map((post) => (
            <BlogCard
              title={post.data.title}
              description={post.data.description}
              pubDate={post.data.pubDate}
              tags={post.data.tags}
              href={`${base}blog/${post.id}/`}
            />
          ))}
        </div>
      )
    }
  </main>
  <Footer />
</Layout>
