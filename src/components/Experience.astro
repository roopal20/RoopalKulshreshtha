---
import { site } from "../content/site";
---

<section id="experience" class="section-max section-pad scroll-mt-24 py-16 sm:py-20">
  <div class="max-w-3xl">
    <h2 class="font-display text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
      {site.experience.title}
    </h2>
    <p class="mt-3 text-ink-muted">{site.experience.intro}</p>
  </div>

  <ol class="mt-10 space-y-8">
    {
      site.experience.items.map((job) => (
        <li class="grid gap-3 border-l-2 border-teal/40 pl-5 sm:grid-cols-[10rem_1fr] sm:gap-8 sm:border-l-0 sm:pl-0">
          <p class="pt-1 text-sm font-medium text-ink-muted">{job.period}</p>
          <div>
            <h3 class="font-display text-xl font-semibold text-ink">
              {job.role}
              <span class="font-sans text-base font-medium text-teal"> · {job.company}</span>
            </h3>
            <p class="mt-2 text-ink-muted">{job.summary}</p>
            <ul class="mt-4 space-y-2 text-sm leading-relaxed text-ink-muted sm:text-base">
              {job.highlights.map((item) => (
                <li class="flex gap-2">
                  <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-coral" aria-hidden="true" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </li>
      ))
    }
  </ol>
</section>
