---
interface Props {
  title: string;
  description: string;
  pubDate: Date;
  href: string;
  tags?: string[];
}

const { title, description, pubDate, href, tags = [] } = Astro.props;
const formatted = pubDate.toLocaleDateString("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
});
---

<article class="border-t border-line pt-6">
  <p class="text-sm font-medium text-ink-muted">{formatted}</p>
  <h3 class="font-display mt-2 text-2xl font-semibold text-ink">
    <a class="transition hover:text-teal" href={href}>{title}</a>
  </h3>
  <p class="mt-2 text-ink-muted">{description}</p>
  {
    tags.length > 0 && (
      <ul class="mt-3 flex flex-wrap gap-2">
        {tags.map((tag) => (
          <li class="text-xs font-semibold uppercase tracking-wide text-teal">{tag}</li>
        ))}
      </ul>
    )
  }
</article>
