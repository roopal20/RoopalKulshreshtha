---
import { site } from "../content/site";
---

<section id="projects" class="section-max section-pad scroll-mt-24 py-16 sm:py-20">
  <div class="max-w-3xl">
    <h2 class="font-display text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
      {site.projects.title}
    </h2>
    <p class="mt-3 text-ink-muted">{site.projects.intro}</p>
  </div>

  <ul class="mt-12 space-y-2">
    {
      site.projects.items.map((project) => (
        <li
          class:list={[
            "group border-t border-line transition duration-300 hover:-translate-y-0.5",
            project.featured ? "pt-10 pb-4" : "py-8",
          ]}
        >
          <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
            <p
              class:list={[
                "font-display font-semibold tabular-nums text-gold",
                project.featured ? "text-3xl sm:text-4xl" : "text-2xl",
              ]}
            >
              {project.number}
            </p>
            <h3
              class:list={[
                "font-display min-w-0 flex-1 font-semibold tracking-tight text-ink transition group-hover:text-teal",
                project.featured ? "text-2xl sm:text-3xl" : "text-xl sm:text-2xl",
              ]}
            >
              {project.link ? (
                <a href={project.link} target="_blank" rel="noreferrer">
                  {project.title}
                </a>
              ) : (
                project.title
              )}
            </h3>
          </div>

          <p class="mt-2 text-sm font-medium text-teal">{project.category}</p>

          <div class:list={[project.featured ? "max-w-3xl" : "max-w-2xl"]}>
            <p
              class:list={[
                "mt-4 leading-relaxed text-ink-muted",
                project.featured ? "text-base sm:text-lg" : "text-sm sm:text-base",
              ]}
            >
              {project.description}
            </p>

            {project.value.length > 0 && (
              <ul class="mt-4 flex flex-wrap gap-x-5 gap-y-1 text-sm text-ink">
                {project.value.map((item) => (
                  <li class="flex items-center gap-2">
                    <span class="h-1 w-1 rounded-full bg-gold" aria-hidden="true" />
                    {item}
                  </li>
                ))}
              </ul>
            )}

            <ul class="mt-5 space-y-2 text-sm leading-relaxed text-ink-muted">
              {project.capabilities.map((item) => (
                <li class="flex gap-2">
                  <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-teal/70" aria-hidden="true" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>

            <div class="mt-6 flex flex-wrap items-center justify-between gap-4">
              <ul class="flex flex-wrap gap-x-3 gap-y-1">
                {project.tags.map((tag) => (
                  <li class="text-xs font-semibold uppercase tracking-wide text-teal">{tag}</li>
                ))}
              </ul>
              {project.link ? (
                <a
                  href={project.link}
                  target="_blank"
                  rel="noreferrer"
                  class="text-sm font-semibold text-ink transition hover:text-teal"
                >
                  View project →
                </a>
              ) : (
                <span class="text-sm font-medium text-ink-muted">Case study on request</span>
              )}
            </div>
          </div>
        </li>
      ))
    }
  </ul>
</section>
