---
import { site } from "../content/site";
---

<section id="contact" class="section-max section-pad scroll-mt-24 py-16 sm:py-24">
  <div class="max-w-2xl border-t border-line pt-12">
    <h2 class="font-display text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
      {site.contact.title}
    </h2>
    <p class="mt-4 text-base leading-relaxed text-ink-muted sm:text-lg">
      {site.contact.body}
    </p>
    {
      site.contact.note && (
        <p class="mt-4 text-sm text-ink-muted">{site.contact.note}</p>
      )
    }
    <a
      href={`mailto:${site.email}`}
      class="mt-8 inline-flex items-center rounded-full bg-ink px-5 py-2.5 text-sm font-semibold text-paper transition hover:-translate-y-px hover:bg-teal-deep"
    >
      {site.contact.cta}
    </a>
  </div>
</section>
