---
import { site } from "../content/site";

const base = import.meta.env.BASE_URL;

function href(path: string) {
  if (path.startsWith("#") || path.startsWith("http")) return path;
  return `${base}${path.replace(/^\//, "")}`;
}

const flow = [
  { id: "user", label: "User" },
  { id: "agent", label: "AI Agent", pulse: true },
  { id: "rag", label: "RAG / Memory" },
  { id: "tools", label: "Tools / APIs" },
  { id: "action", label: "Business Action" },
];
---

<section class="section-max section-pad relative overflow-hidden pb-14 pt-12 sm:pb-20 sm:pt-16">
  <div class="grid items-center gap-12 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)] lg:gap-10">
    <div class="relative z-10 min-w-0">
      <p class="reveal text-sm font-semibold uppercase tracking-[0.18em] text-teal">
        {site.hero.eyebrow}
      </p>

      <h1 class="reveal reveal-delay-1 font-display mt-5 text-4xl font-semibold leading-[1.08] tracking-tight text-ink sm:text-5xl lg:text-6xl">
        {site.name}
      </h1>

      <p class="reveal reveal-delay-2 mt-4 text-lg font-medium text-teal sm:text-xl">
        {site.role}
      </p>

      <p class="reveal reveal-delay-2 mt-6 max-w-xl text-base leading-relaxed text-ink-muted sm:text-lg">
        {site.tagline}
      </p>

      <div class="reveal reveal-delay-3 mt-9 flex flex-wrap items-center gap-3">
        <a
          href={href(site.hero.ctaPrimaryHref)}
          class="inline-flex items-center rounded-full bg-ink px-5 py-2.5 text-sm font-semibold text-paper transition hover:-translate-y-px hover:bg-teal-deep"
        >
          {site.hero.ctaPrimary}
        </a>
        <a
          href={href(site.hero.ctaSecondaryHref)}
          class="inline-flex items-center rounded-full border border-line bg-white/60 px-5 py-2.5 text-sm font-semibold text-ink transition hover:-translate-y-px hover:border-teal hover:text-teal"
        >
          {site.hero.ctaSecondary}
        </a>
      </div>

      {
        site.availability && (
          <p class="reveal reveal-delay-3 mt-6 text-sm text-ink-muted">
            <span class="mr-2 inline-block h-1.5 w-1.5 rounded-full bg-gold align-middle" aria-hidden="true" />
            {site.availability}
          </p>
        )
      }
    </div>

    <div
      class="reveal reveal-delay-2 relative mx-auto w-full max-w-md lg:mx-0 lg:max-w-none"
      aria-label="AI system flow: User to AI Agent to RAG Memory to Tools to Business Action"
    >
      <div
        class="relative overflow-hidden rounded-[1.75rem] border border-line/70 bg-gradient-to-br from-white/70 via-paper-deep/40 to-teal/[0.07] px-5 py-8 sm:px-8 sm:py-10"
      >
        <div
          class="pointer-events-none absolute inset-0 opacity-[0.28]"
          style="background-image: linear-gradient(rgba(11,95,92,0.14) 1px, transparent 1px), linear-gradient(90deg, rgba(11,95,92,0.14) 1px, transparent 1px); background-size: 24px 24px;"
          aria-hidden="true"
        >
        </div>

        <ol class="relative flex flex-col items-stretch gap-0">
          {
            flow.map((node, index) => (
              <li class="flex flex-col items-center">
                <div
                  class:list={[
                    "relative z-10 flex min-h-11 w-full max-w-[14rem] items-center justify-center rounded-full border px-4 py-2.5 text-center text-xs font-semibold uppercase tracking-[0.12em] sm:text-[0.7rem]",
                    node.pulse
                      ? "node-pulse border-teal/50 bg-teal text-white"
                      : "border-line bg-white/80 text-ink",
                  ]}
                >
                  {node.label}
                </div>
                {index < flow.length - 1 && (
                  <div class="flex h-7 w-px flex-col items-center justify-center" aria-hidden="true">
                    <span class="h-full w-px bg-gradient-to-b from-teal/50 to-gold/40" />
                  </div>
                )}
              </li>
            ))
          }
        </ol>

        <p class="relative mt-8 text-center text-[0.7rem] font-medium uppercase tracking-[0.16em] text-ink-muted">
          AI · Agents · Systems · Execution
        </p>
      </div>
    </div>
  </div>
</section>
