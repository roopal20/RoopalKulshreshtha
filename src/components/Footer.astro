---
import { site } from "../content/site";

const year = new Date().getFullYear();
const base = import.meta.env.BASE_URL;
---

<footer class="mt-24 border-t border-line/80">
  <div class="section-max section-pad flex flex-col gap-3 py-10 sm:flex-row sm:items-center sm:justify-between">
    <p class="text-sm text-ink-muted">
      © {year} {site.name}. {site.footer.note}
    </p>
    <div class="flex gap-4 text-sm font-medium">
      {
        site.social.linkedin && (
          <a class="text-ink-muted transition hover:text-teal" href={site.social.linkedin} target="_blank" rel="noreferrer">
            LinkedIn
          </a>
        )
      }
      {
        site.social.github && (
          <a class="text-ink-muted transition hover:text-teal" href={site.social.github} target="_blank" rel="noreferrer">
            GitHub
          </a>
        )
      }
      <a class="text-ink-muted transition hover:text-teal" href={`${base}blog`}>Blog</a>
    </div>
  </div>
</footer>
