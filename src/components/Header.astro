---
import { site } from "../content/site";

const base = import.meta.env.BASE_URL;

function href(path: string) {
  if (path.startsWith("#") || path.startsWith("http")) return path;
  const clean = path.replace(/^\//, "");
  return `${base}${clean}`;
}
---

<header
  class="sticky top-0 z-40 border-b border-line/70 bg-paper/80 backdrop-blur-md"
>
  <div class="section-max section-pad flex h-16 items-center justify-between gap-4">
    <a
      href={base}
      class="font-display text-lg font-semibold tracking-tight text-ink transition hover:text-teal"
    >
      {site.name}
    </a>

    <nav class="hidden items-center gap-6 text-sm font-medium text-ink-muted md:flex" aria-label="Primary">
      {
        site.nav.map((item) => (
          <a
            href={href(item.href)}
            class="transition hover:text-teal"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <a
      href={href(site.hero.ctaSecondaryHref)}
      class="rounded-full bg-teal px-3.5 py-1.5 text-sm font-semibold text-white transition hover:bg-teal-deep"
    >
      Résumé
    </a>
  </div>
</header>
