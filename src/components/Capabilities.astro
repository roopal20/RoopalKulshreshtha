---
import { site } from "../content/site";
---

<section id="capabilities" class="section-max section-pad scroll-mt-24 py-14 sm:py-16">
  <div class="max-w-3xl">
    <h2 class="font-display text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
      {site.capabilities.title}
    </h2>
    <p class="mt-3 text-ink-muted">{site.capabilities.intro}</p>
  </div>

  <ul class="mt-10 grid gap-0 sm:grid-cols-2">
    {
      site.capabilities.items.map((item) => (
        <li class="border-t border-line py-6 sm:pr-8">
          <h3 class="text-sm font-semibold uppercase tracking-[0.14em] text-teal">
            {item.label}
          </h3>
          <p class="mt-3 text-base leading-relaxed text-ink-muted">{item.body}</p>
        </li>
      ))
    }
  </ul>
</section>
